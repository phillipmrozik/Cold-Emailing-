    },
    {
      "parameters": {
        "url": "={{ 'https://dns.google/resolve?type=A&name=' + encodeURIComponent($('Wybierz adresy do sprawdzenia').item.json.blad ? 'invalid.invalid' : $('Wybierz adresy do sprawdzenia').item.json.domena) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "id": "7564b234-fefc-4ecc-bdb5-c2233fd8f75a",
      "name": "DNS: adres domeny (A)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        96
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const grupy = $('Wybierz adresy do sprawdzenia').all().map(function (i) { return i.json; });\nconst mx = $('DNS: serwer poczty (MX)').all().map(function (i) { return i.json || {}; });\nconst a = $input.all().map(function (i) { return i.json || {}; });\nconst wynik = [];\ngrupy.forEach(function (g, i) {\n  let ocena = 'ok';\n  let powod = '';\n  if (g.blad) { ocena = 'zly'; powod = g.blad; }\n  else {\n    const m = mx[i] || {};\n    const rekordyMx = (m.Answer || []).filter(function (r) { return r.type === 15; });\n    const prawdziweMx = rekordyMx.filter(function (r) { return !/^0\\s+\\.?$/.test(String(r.data).trim()); });\n    const rekordyA = ((a[i] || {}).Answer || []).filter(function (r) { return r.type === 1 || r.type === 5; });\n    if (m.Status === 3) { ocena = 'zly'; powod = 'domena ' + g.domena + ' nie istnieje'; }\n    else if (m.Status === 0 && prawdziweMx.length) ocena = 'ok';\n    else if (m.Status === 0 && rekordyMx.length) { ocena = 'zly'; powod = 'domena ' + g.domena + ' nie przyjmuje poczty'; }\n    else if (m.Status === 0 && (a[i] || {}).Status === 0 && rekordyA.length) ocena = 'ok';\n    else if (m.Status === 0) { ocena = 'zly'; powod = 'domena ' + g.domena + ' nie ma serwera poczty'; }\n    else ocena = 'pozniej';\n  }\n  if (ocena === 'pozniej') return;\n  g.firmy.forEach(function (f) { wynik.push({ json: { id: f.id, email: f.email, ok: ocena === 'ok', powod: powod ? 'zły adres: ' + powod + ' (sprawdzone przed wysyłką)' : '' } }); });\n});\nreturn wynik;"
      },
