      "id": "7c2e457e-2186-431e-a7c5-6a8b15b2266b",
      "name": "Gotowe maile do sprawdzenia",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        224,
        96
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const FORMAT = /^[a-z0-9._%+-]+@([a-z0-9-]+\\.)+[a-z]{2,}$/;\nconst ATRAPY = /(example|przyklad|twoj(a|e)?(mail|email|adres)|your(mail|email)|email@email|test@test|^noreply|^no-reply|^nie-odpowiadaj|^donotreply|\\.(png|jpe?g|gif|webp|svg)$)/;\nconst firmy = $input.all().map(function (i) { return i.json; }).filter(function (f) { return f && f.id && f.email && !f.email_sprawdzony; }).slice(0, 60);\nconst grupy = {};\nfirmy.forEach(function (f) {\n  const email = String(f.email).trim().toLowerCase();\n  let blad = '';\n  if (!FORMAT.test(email)) blad = 'adres ma zły format';\n  else if (ATRAPY.test(email)) blad = 'adres wygląda na przykładowy albo bez odpowiedzi';\n  const domena = blad ? '-' : email.split('@')[1];\n  const klucz = blad ? 'zle-' + f.id : domena;\n  if (!grupy[klucz]) grupy[klucz] = { domena: domena, blad: blad, firmy: [] };\n  grupy[klucz].firmy.push({ id: f.id, email: email });\n});\nreturn Object.keys(grupy).map(function (k) { return { json: grupy[k] }; });"
      },
      "id": "51b23992-9599-4aa6-a55e-d842eb94c87d",
      "name": "Wybierz adresy do sprawdzenia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://dns.google/resolve?type=MX&name=' + encodeURIComponent($json.blad ? 'invalid.invalid' : $json.domena) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "id": "da735606-df24-4d88-8058-72f35207f8c3",
      "name": "DNS: serwer poczty (MX)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        96
      ],
      "retryOnFail": true,
      "maxTries": 2,
